{
    "contract_version":  "SIGMALYTIC_V2_STEP68_APPEND_ONLY_UNIVERSE_SNAPSHOT_INGEST_CONTRACT_2026_07_09",
    "mode":  "LOCAL_DESIGN_ONLY_NO_DB_CALL_NO_SUPABASE_WRITE_NO_READINESS_ADVANCE",
    "purpose":  "Define the controlled append-only ingest boundary required to populate campaign_universe_snapshots and campaign_universe_symbols.",
    "source_law":  {
                       "authorized_source":  "Alpaca active/tradable asset universe or an explicitly reviewed equivalent live universe source",
                       "forbidden_source":  "daily_bars symbols, campaign symbols, ranks, scores, probabilities, or trade outputs",
                       "reason":  "Bars-symbol coverage is diagnostic only and cannot be promoted into the live/persisted universe source."
                   },
    "ingest_write_scope":  {
                               "allowed_future_writes":  [
                                                             "insert exactly one row into public.campaign_universe_snapshots",
                                                             "insert normalized symbol rows into public.campaign_universe_symbols for that snapshot_id"
                                                         ],
                               "forbidden_writes":  [
                                                        "no campaigns insert/update/delete",
                                                        "no daily_bars insert/update/delete",
                                                        "no readiness mutation",
                                                        "no D3D authorization",
                                                        "no operator-control confirmation",
                                                        "no trade signal generation",
                                                        "no Stripe or billing activation"
                                                    ],
                               "append_only":  true,
                               "update_existing_snapshots":  false,
                               "delete_existing_snapshots":  false
                           },
    "minimum_snapshot_requirements":  {
                                          "snapshot_id":  "generated UUID",
                                          "source":  "ALPACA_ASSETS_ACTIVE_TRADABLE or explicitly reviewed equivalent",
                                          "as_of_utc":  "current UTC timestamp",
                                          "universe_count":  "positive integer matching inserted symbol rows",
                                          "symbols_hash":  "stable SHA256 hash of normalized symbol list",
                                          "write_authorization_ref":  "explicit user authorization record",
                                          "is_current":  "true only after insert completes successfully"
                                      },
    "validation_after_ingest":  {
                                    "read_only_checks":  [
                                                             "campaign_universe_snapshots has current authorized snapshot",
                                                             "campaign_universe_symbols has rows for current snapshot_id",
                                                             "universe_count equals symbols row count",
                                                             "symbols are uppercase-normalized",
                                                             "live GET reader reports persisted_universe_available=true",
                                                             "live GET reader reports universe_count \u003e 0",
                                                             "validation_complete may only become true after all coverage gates pass"
                                                         ],
                                    "readiness_update":  "separate explicit audit step only; never automatic inside ingest"
                                },
    "doctrine":  {
                     "operator_control_is_evidence_not_score":  true,
                     "no_database_call_in_this_step":  true,
                     "no_supabase_write_in_this_step":  true,
                     "no_campaign_mutation":  true,
                     "no_readiness_advance":  true,
                     "no_nightly_run":  true,
                     "no_d3d":  true,
                     "no_operator_control_confirmation":  true,
                     "no_trade_signal":  true,
                     "no_stripe":  true,
                     "billing_remains_blocked":  true
                 }
}
