# ── Alpaca credentials ────────────────────────────────────────────────────
# Get these from https://alpaca.markets → Your API Keys
ALPACA_API_KEY=your_alpaca_key_id_here
ALPACA_API_SECRET=your_alpaca_secret_here

# paper=true uses paper trading endpoint (free, delayed)
# paper=false uses live SIP feed (requires funded account or data subscription)
ALPACA_PAPER=true

# ── Service URLs (set these in Render / Railway dashboard) ────────────────
# Backend FastAPI service
BACKEND_URL=http://localhost:8000

# WebSocket URL (same host, ws:// protocol)
BACKEND_WS_URL=ws://localhost:8000

# ── Alpaca data endpoint (do not change unless using a different tier) ─────
ALPACA_BASE_URL=https://data.alpaca.markets
